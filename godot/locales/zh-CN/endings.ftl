ending--bad_reputation =
    .title = 臭名昭著
    .desc =
        食堂的声誉已经跌至谷底，再也没有学生愿意来这里就餐了。
        你的经营之路到此为止。

ending--good_reputation =
    .title = 声名远扬
    .desc =
        你的食堂声誉卓著，成为了校园里最受欢迎的就餐地点！
        学生们纷纷称赞你的管理才能。
        你可以选择继续经营，或者功成身退。


ending--rectification =
    .title = 关停整改
    .desc =
        由于食品安全问题频发，食堂被责令关停整改。
        你的经营生涯就此结束。
