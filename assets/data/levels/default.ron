(
    id: "sample_level",
    run_length: 3600.0,
    seed: 42,
    start_reputation: (
        reputation: 50.0,
        fsri: 10.0,
        food_quality: 60.0,
    ),
    diner_pool: (
        initial_pool_size: 500,
    ),
    diner_randomizer: (
        personality: (
            frugality: (0.1, 0.5),       // Price sensitivity
            adventurous: (0.2, 0.8),     // Willingness to try new dishes
            confrontational: (0.1, 0.6), // Tendency to complain
            patience_base: (60.0, 300.0), // Base patience in seconds
            decisiveness: (0.2, 0.8),    // Decision-making speed
            adaptiveness: (0.1, 0.6),    // Flexibility to changes
        ),
        dining: (
            economic_capacity: (10.0, 20.0), // Student budget range (yuan)
            max_satiation: (80.0, 130.0),    // Appetite variation (small to large)
            eating_speed: (0.5, 1.25),        // Eating speed multiplier
        ),
        movement: ( // unused
            movement_speed: (1.0, 3.0),
            avoidance_speed: (0.5, 2.0),
            arrival_threshold: (0.1, 0.5),
        ),
        appearance: (
            head_variants: 63,
            upper_garment_variants: 2,
            hand_variants: 16,
            shoe_variants: 2,
        ),
    ),

    canteen: "main_canteen",
    window_configurations: [
        // 套餐窗口 (Combo Window) - slot 0
        (
            slot_index: 0,
            service: "combo_window_roast",
        ),
        // 大伙窗口 (Main Dish Windows) - slots 1-2
        (
            slot_index: 1,
            service: "main_window_sichuan",
        ),
        (
            slot_index: 2,
            service: "main_window_homestyle",
        ),
        // 面食窗口 (Noodle Window) - slot 3
        (
            slot_index: 3,
            service: "noodle_window_soup",
        ),
        // 小吃窗口 (Snack Window) - slot 4
        (
            slot_index: 4,
            service: "snack_window_dumplings",
        ),
        // 特色窗口 (Specialty Window) - slot 5
        (
            slot_index: 5,
            service: "specialty_window_fish",
        ),
    ],

    table_placements: [
