// Configuration for window/canteen selection decision-making
//
// This file controls how diners choose which window or canteen to visit
// based on taste preferences, quality expectations, price, and novelty.
(
    // Scoring weights for different factors (should sum to ~1.0 for normalized scores)
    weights: (
        // Weight for taste/preference match (0.0-1.0)
        // Higher = diners prioritize dishes they like
        taste: 0.45,

        // Weight for quality expectations (0.0-1.0)
        // Higher = diners prioritize high-quality dishes
        quality: 0.25,

        // Weight for price attractiveness (0.0-1.0)
        // Higher = diners are more price-sensitive
        price: 0.2,

        // Weight for novelty bonus (0.0-1.0)
        // Higher = diners seek out new dishes they haven't tried
        novelty: 0.1,
    ),

    // Temperature for softmax sampling (default: 1.0)
    // Lower values (e.g., 0.5) make diners greedier (always pick best option)
    // Higher values (e.g., 2.0) make diners more exploratory (random choices)
    temperature: 1.0,

    // Wait time penalty gamma factor (default: 3.0)
    // Controls how much long queues deter diners
    // Higher = longer queues are more punishing
    wait_penalty_gamma: 3.0,

    // Price injustice threshold (default: 0.25)
    // Fraction above base price that triggers "overpriced" perception
    // e.g., 0.25 = dishes priced 25% above base feel unfair
    price_injustice_threshold: 0.25,

    // Mood penalty when abandoning queue (default: 0.2)
    // How much mood drops when a diner gives up and leaves
    // Range: 0.0 (no penalty) to 1.0 (severe penalty)
    abandon_mood_penalty: 0.2,
)
