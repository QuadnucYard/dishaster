(
    world: (
        world_bound: (min: (-10.0, -6.0), max: (10.0, 6.0)),
        food_spawn_interval: 0.15,
        face_spawn_interval: 0.2,
        text_spawn_interval: 1.0,
        max_foods: 25,
        max_faces: 8,
        max_texts: 4,
        gravity: 9.8,
    ),

    assets: (
        food_prefab: "opening/food",
        face_prefab: "opening/face",
        text_prefab: "opening/text",
        food_variant_count: 110,
        face_variant_count: 63,
        review_texts: [
            // 讽刺夸张类
            "此食堂当为世界第八大奇迹！",
            "吃完感觉灵魂得到了升华！",
            "建议直接列入非物质文化遗产",
            "食材新鲜度：刚从侏罗纪挖出来",
            "厨师是不是在用爱发电？",
            "食堂教会我，生活就是一场赌博",
            "薛定谔的食堂：打开饭盒前，什么都有可能",
            "吃完后我看见了第五维度",
            "每个窗口都通往不同的平行宇宙",
            // 哲学思考类
            "在排队中思考人生的意义",
            "食堂是检验勇气的唯一标准",
            "今天的菜，明天的回忆",
            "饥饿是最好的调味品",
            "吃饭不是目的，活着才是",
            "每一口都是对命运的挑战",
            // 戏谑吐槽类
            "阿姨的手抖得恰到好处",
            "价格合理，分量感人",
            "这个味道，有点东西",
            "我来食堂不是为了吃饱",
            "打饭阿姨：手有点抖，别见怪",
            "菜品创新：昨天的肉今天的汤",
            "食堂三宝：油水盐",
            "排队半小时，吃完三分钟",
            "这个价位，还要什么自行车",
            "阿姨说：这是特供",
            // 玄学类
            "今日运势：适合下馆子",
            "量子纠缠的打饭手法",
            "测不准原理：饭量版",
            "这是一道会思考的菜",
            "食堂传送门已激活",
            "时空扭曲的味蕾体验",
            "多元宇宙中的食堂",
            // 神秘推荐类
            "别问，问就是特色",
            "阿姨良心推荐",
            "这个你值得拥有",
            "今日限定，过期不候",
            "本店招牌，童叟无欺",
            "秘制配方，祖传手艺",
            "食材直送，新鲜到家",
            // 情感共鸣类
            "想家的时候就来食堂",
            "这里有妈妈的味道（并没有）",
            "青春就是每天吃食堂",
            "毕业后最怀念的地方",
            "和室友一起吐槽的日子",
            "食堂见证了我的成长",
            // 励志类
            "今天也要努力干饭！",
            "为了梦想，吃饱再说",
            "干饭人，干饭魂",
            "饭可以乱吃，话不能乱说",
            "人是铁，饭是钢",
            "吃饱了才有力气吐槽",
            // 科技感类
            "AI都做不出这个味道",
            "未来食品的雏形",
            "这是什么黑科技",
            "分子料理，懂的都懂",
            "食堂2.0测试版",
            // 抽象艺术类
            "这是一种态度",
            "理解不了就对了",
            "艺术来源于生活",
            "这就是行为艺术",
            "先锋实验料理",
            "你品，你细品",
            // 终极吐槽类
            "再见了，食堂君",
            "感谢食堂让我学会外卖",
            "食堂教我学会了做饭",
            "外卖它不香吗",
            "我与食堂的爱恨情仇",
            "食堂，我们下辈子再见",
        ],
    )
)
